# Configuración de la plataforma (el instalador crea /opt/czyradio/plataforma.env con valores reales)
DATOS=/opt/czyradio/datos
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esto
SAL_VOTOS=texto-aleatorio-largo
AZURACAST_URL=http://127.0.0.1:8080
AZURACAST_EMISORA=czyradio
AZURACAST_MEDIA=/var/lib/docker/volumes/azuracast_station_data/_data/czyradio/media
TOP40_LOCUTORES=/opt/czyradio/locutores/top40.json
ORIGENES_WEB=https://czyradio.com,https://www.czyradio.com,https://xoxeli83.github.io
WHISPER_MODELO=small
MAX_MB=25
URL_PUBLICA_API=https://radio.czyradio.com/plataforma
URL_WEB=https://czyradio.com/
NOMBRE_RADIO=Crazy rAdIo
LOCUTORES_DIR=/opt/czyradio/locutores
# Correo SMTP (Brevo: smtp-relay.brevo.com · Gmail: smtp.gmail.com con contraseña de aplicación)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=Crazy rAdIo <hola@czyradio.com>
CORREO_ADMIN=
# Solo para pruebas en local: devuelve el código en la respuesta. NUNCA en el servidor real.
# DEV_MOSTRAR_CODIGO=1
# Pagos de publicidad con Stripe (dashboard.stripe.com → Desarrolladores → Claves API / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IVA=0.21
# Precios propios (opcional), p. ej.: TARIFAS_JSON={"banner_mes":{"precio":59}}
