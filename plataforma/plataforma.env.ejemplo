# Configuración de la plataforma (el instalador crea /opt/airadio/plataforma.env con valores reales)
DATOS=/opt/airadio/datos
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esto
SAL_VOTOS=texto-aleatorio-largo
AZURACAST_URL=http://127.0.0.1:8080
AZURACAST_EMISORA=airadio
AZURACAST_MEDIA=/var/lib/docker/volumes/azuracast_station_data/_data/airadio/media
TOP40_LOCUTORES=/opt/airadio/locutores/top40.json
ORIGENES_WEB=https://xoxeli83.github.io
WHISPER_MODELO=small
MAX_MB=25
